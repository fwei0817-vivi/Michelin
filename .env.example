# Copy to .env (gitignored). API keys for the LLM stage go here; the frontend and the
# optimizer run without any.

# LLM dish-name matching (optional; needs `uv sync --extra llm`). See src/michelin/parse/matcher.py.
# Default provider: gemini-2.5-pro on Vertex AI with gcloud Application Default Credentials.
# MICHELIN_LLM_MATCH=1
# MICHELIN_LLM_PROVIDER=gemini        # or claude-vertex, or claude (needs ANTHROPIC_API_KEY)
# GOOGLE_CLOUD_PROJECT=ieor-4576-487001
# GOOGLE_CLOUD_LOCATION=us-central1
